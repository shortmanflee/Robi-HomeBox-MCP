# --- HomeBox connection ---------------------------------------------------------
# Base URL of HomeBox (without /api). Inside compose, use the service name.
HOMEBOX_URL=http://homebox:7745

# Option A: service account (token is refreshed automatically)
HOMEBOX_USERNAME=mcp@example.com
HOMEBOX_PASSWORD=change-me
# Option B: HomeBox API key (Profile -> API keys); takes precedence over A
#HOMEBOX_API_KEY=

#HOMEBOX_VERIFY_SSL=true
#HOMEBOX_TIMEOUT=30

# --- MCP server -----------------------------------------------------------------
# Bearer token(s) clients must send. Comma-separate to allow several / rotate.
# Generate with:  openssl rand -hex 32
MCP_AUTH_TOKENS=

#MCP_TRANSPORT=http          # or stdio for local single-user use
#MCP_PORT=8000
#MCP_PATH=/mcp
#MCP_READ_ONLY=false         # true = only search/get/list/report tools are exposed
#MCP_MAX_ATTACHMENT_MB=10
#MCP_ALLOW_URL_FETCH=true   # upload_attachment_from_url (public HTTPS only)
# Server-side tool search for clients WITHOUT native tool search: off | bm25 | regex.
# Lists only search_entities, get_entity, search_tools and call_tool. Leave off for
# Claude Code / the Claude API, which defer and search MCP tools client-side.
#MCP_TOOL_SEARCH=off
#MCP_TOOL_SEARCH_MAX_RESULTS=5
# Optional Host-header allowlist (DNS-rebinding protection), e.g. the names/IPs you use:
#MCP_ALLOWED_HOSTS=homebox-mcp.lan,192.168.1.20:8000
#LOG_LEVEL=INFO

# --- Dev stack only (docker-compose.dev.yml) -------------------------------------
# HomeBox >= 0.27 refuses to start without this. Generate: openssl rand -base64 48
#HBOX_AUTH_API_KEY_PEPPER=

# Secrets can also be read from files (Docker secrets):
#   HOMEBOX_PASSWORD_FILE, HOMEBOX_API_KEY_FILE, MCP_AUTH_TOKENS_FILE
